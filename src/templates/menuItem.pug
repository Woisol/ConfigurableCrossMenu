button(class=`ccm-items ${direction}`,
  onclick = action, href = url style={
    '--ccm-item-size': size,
    '--ccm-item-deg': rotate,
    '--ccm-item-x': x,
      '--ccm-item-offset': offset,
      '--ccm-item-hover-offset': hoverOffset,
    '--ccm-item-bg-color': bgColor})
    if url
      a(href=url rel="noopener noreferrer")
        = label
    else
      = label